# Where /api/* is proxied to (the FastAPI backend). Server-side only, read at build time.
BACKEND_URL=http://127.0.0.1:8000
# 1 = no backend: fixture answers and a fake SSE stream (demo mode).
NEXT_PUBLIC_MOCK=0
# Base path the browser calls. Default /api (the rewrite above); rarely changed.
NEXT_PUBLIC_API_BASE=/api
